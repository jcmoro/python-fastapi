ENV=dev
LOG_LEVEL=DEBUG
APP_NAME=catalog-api
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://catalog:catalog@db:5432/catalog
TEST_DATABASE_URL=postgresql+asyncpg://catalog:catalog@db-test:5432/catalog_test

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=4096

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
